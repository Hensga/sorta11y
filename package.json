{
  "name": "sorta11y",
  "version": "0.1.0-alpha.0",
  "description": "Accessible, zero-dependency vanilla-JS sortable list — keyboard reordering and pointer drag with screen-reader announcements. No framework, no jQuery, no build step.",
  "keywords": [
    "sortable",
    "drag-and-drop",
    "accessibility",
    "a11y",
    "keyboard",
    "screen-reader",
    "aria",
    "vanilla-js",
    "zero-dependency",
    "reorder",
    "i18n"
  ],
  "license": "MIT",
  "author": "Henning Huth",
  "homepage": "https://github.com/Hensga/sorta11y#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hensga/sorta11y.git"
  },
  "bugs": {
    "url": "https://github.com/Hensga/sorta11y/issues"
  },
  "main": "src/sorta11y.js",
  "browser": "src/sorta11y.js",
  "unpkg": "src/sorta11y.js",
  "jsdelivr": "src/sorta11y.js",
  "style": "src/sorta11y.css",
  "exports": {
    ".": "./src/sorta11y.js",
    "./locales/*": "./src/locales/*.js",
    "./style.css": "./src/sorta11y.css"
  },
  "files": [
    "src/",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "tag": "alpha"
  },
  "scripts": {
    "prepublishOnly": "npm run coverage && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "python3 -m http.server 8090",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "prettier": "3.8.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
