{
  "name": "sorta11y",
  "version": "0.1.0-alpha.1",
  "description": "Accessible, zero-dependency vanilla-JS sortable list — keyboard reordering and pointer drag with screen-reader announcements. No framework, no jQuery, no build step.",
  "keywords": [
    "sortable",
    "drag-and-drop",
    "accessibility",
    "a11y",
    "keyboard",
    "screen-reader",
    "aria",
    "vanilla-js",
    "zero-dependency",
    "reorder",
    "i18n"
  ],
  "license": "MIT",
  "author": "Henning Huth",
  "homepage": "https://hensga.github.io/sorta11y/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hensga/sorta11y.git"
  },
  "bugs": {
    "url": "https://github.com/Hensga/sorta11y/issues"
  },
  "main": "src/sorta11y.js",
  "types": "src/sorta11y.d.ts",
  "browser": "src/sorta11y.js",
  "unpkg": "src/sorta11y.js",
  "jsdelivr": "src/sorta11y.js",
  "style": "src/sorta11y.css",
  "exports": {
    ".": {
      "types": "./src/sorta11y.d.ts",
      "default": "./src/sorta11y.js"
    },
    "./locales/*": {
      "types": "./src/locales/*.d.ts",
      "default": "./src/locales/*.js"
    },
    "./style.css": {
      "types": "./src/sorta11y.css.d.ts",
      "default": "./src/sorta11y.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "./src/locales/*.js"
  ],
  "publishConfig": {
    "tag": "alpha"
  },
  "scripts": {
    "prepublishOnly": "npm run coverage && npm run test:types && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:types": "tsc -p test/types/tsconfig.node16.json && tsc -p test/types/tsconfig.nodenext.json && tsc -p test/types/tsconfig.bundler.json",
    "demo": "python3 -m http.server 8090",
    "preview": "npm --prefix website run build && sh scripts/assemble-pages.sh _preview/sorta11y && python3 -m http.server 8090 --directory _preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
